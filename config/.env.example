# ============================================================
#  FICHIER DE SECRETS — COPIEZ CE FICHIER EN .env
#  IMPORTANT : Le fichier .env ne doit JAMAIS être partagé
#              ni ajouté à git (il est dans .gitignore)
# ============================================================

# --- BINANCE TESTNET (paper trading) ---
# 1. Allez sur https://testnet.binancefuture.com/
# 2. Connectez-vous avec votre compte GitHub
# 3. Cliquez sur "Generate Key" dans les paramètres API
# 4. Copiez les clés ici
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# --- BINANCE PRODUCTION (argent réel — laisser vide pour l'instant) ---
# N'activez ces clés que lorsque le bot a prouvé ses performances
# pendant plusieurs semaines en paper trading.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- NEWS API (optionnel — améliore l'analyse fondamentale) ---
# CryptoPanic : inscription gratuite sur https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=

# NewsAPI : inscription gratuite sur https://newsapi.org/
NEWSAPI_KEY=
